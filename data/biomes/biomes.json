        },
        {
          "id": "forest_subalpine",
          "name": {
            "es": "Bosque subalpino",
            "en": "Subalpine forest"
          },
          "description": {
            "es": "Bosque de alta montaña situado cerca del límite natural de crecimiento de los árboles. Predominan con frecuencia las coníferas adaptadas al frío, y la vegetación se vuelve más dispersa hacia las laderas rocosas y la zona alpina.",
            "en": "A high-mountain forest near the natural upper limit of tree growth. Cold-adapted conifers are often common, and tree cover becomes more scattered toward rocky slopes and the alpine zone."
          },
          "spawn": {
            "required": {
              "terrain": "land",
              "distanceBelowLocalTreelineMeters": {
                "min": 0,
                "max": 700
              },
              "annualPrecipitationMm": {
