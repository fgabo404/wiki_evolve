              },
              "distanceToCoastKm": {
                "min": 0,
                "max": 80
              }
            }
          }
        },
        {
          "id": "forest_wooded_swamp",
          "name": {
            "es": "Pantano arbolado (Everglades)",
            "en": "Forested swamp (Everglades)"
          },
          "description": {
            "es": "Bosque de zonas bajas y húmedas cuyo suelo permanece saturado o se inunda durante parte del año. Sus árboles y otras plantas están adaptados al exceso de agua y forman un ecosistema de transición entre tierra firme y humedales.",
            "en": "A forest of low-lying, wet areas where the soil remains saturated or floods during part of the year. Its trees and other plants are adapted to excess water, forming a transition between dry land and wetlands."
          },
          "spawn": {
            "required": {
              "terrain": "land",
              "soilSaturatedDuringGrowingSeason": true,
              "wetlandWaterType": "freshwater"
            },
