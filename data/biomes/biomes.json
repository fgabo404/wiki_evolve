      "subbiomes": [
        {
          "id": "forest_tropical",
          "name": {
            "es": "Selva",
            "en": "Rainforest"
          },
          "description": {
            "es": "Bosque tropical cálido y muy húmedo, con vegetación densa, árboles altos y varios estratos de plantas. Recibe lluvias abundantes durante gran parte del año y alberga una elevada diversidad de especies.",
            "en": "A warm, very humid tropical forest with dense vegetation, tall trees, and multiple plant layers. It receives abundant rainfall during much of the year and supports exceptionally diverse wildlife and plant life."
          },
          "spawn": {
            "required": {
              "terrain": "land",
              "meanAnnualTemperatureC": {
                "min": 20,
                "max": 30
              },
              "annualPrecipitationMm": {
