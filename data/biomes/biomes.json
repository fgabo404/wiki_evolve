                "max": 1500
              },
              "annualPrecipitationMm": {
                "min": 2000,
                "max": 4000
              },
              "meanAnnualRelativeHumidityPercent": {
                "min": 75,
                "max": 90
              },
              "absoluteLatitudeDegrees": {
                "min": 0,
                "max": 23.5
              }
            }
          }
        },
        {
          "id": "forest_cloud",
          "name": {
            "es": "Bosque nuboso",
            "en": "Cloud Forest"
          },
          "description": {
            "es": "Bosque húmedo de montaña donde las nubes bajas y la niebla envuelven frecuentemente la vegetación. Los árboles suelen estar cubiertos de musgos, helechos, bromelias y orquídeas, y sus copas capturan humedad de las gotas suspendidas en el aire.",
            "en": "A humid montane forest frequently immersed in low clouds and mist. Trees are often covered with mosses, ferns, bromeliads, and orchids, and their canopies intercept moisture from water droplets suspended in the air."
          },
          "spawn": {
            "required": {
              "terrain": "land",
              "cloudImmersionFrequent": true
            },
            "preferred": {
              "meanAnnualTemperatureC": {
                "min": 10,
                "max": 22
              },
              "annualPrecipitationMm": {
                "min": 1200,
                "max": 3500
              },
              "meanAnnualRelativeHumidityPercent": {
                "min": 80,
                "max": 100
              },
              "elevationMeters": {
                "min": 400,
                "max": 2800
              }
            }
          }
        },
        {
          "id": "forest_temperate",
          "name": {
            "es": "Templado",
            "en": "Temperate"
          },
          "description": {
            "es": "Bosque de clima templado inspirado en los paisajes forestales de Europa central y occidental. Predominan las hayas, los robles y otros árboles de hoja caduca, a veces mezclados con coníferas. Presenta estaciones marcadas: follaje verde en primavera y verano, colores cálidos en otoño y muchos árboles sin hojas en invierno.",
            "en": "A temperate forest inspired by the woodland landscapes of Central and Western Europe. Beeches, oaks, and other deciduous trees predominate, sometimes mixed with conifers. It has distinct seasons: green foliage in spring and summer, warm autumn colors, and many leafless trees in winter."
          },
          "spawn": {
            "required": {
              "terrain": "land",
              "monthsMeanTemperatureAbove10C": {
                "min": 4,
                "max": 8
              },
              "annualPrecipitationMm": {
                "min": 450
              }
            },
            "preferred": {
              "meanAnnualTemperatureC": {
                "min": 4,
                "max": 15
              },
              "annualPrecipitationMm": {
                "min": 650,
                "max": 1800
              },
              "elevationMeters": {
                "min": 0,
                "max": 2000
              },
              "absoluteLatitudeDegrees": {
                "min": 30,
                "max": 60
              }
            }
          }
        },
        {
          "id": "forest_boreal",
          "name": {
            "es": "Boreal (taiga)",
            "en": "Boreal (taiga)"
          },
          "description": {
            "es": "Bosque de regiones frías, conocido también como taiga, con inviernos largos y veranos cortos. Suele estar dominado por coníferas resistentes al frío, aunque también puede incluir árboles de hoja caduca.",
            "en": "A forest of cold regions, also known as taiga, with long winters and short summers. It is commonly dominated by cold-adapted conifers, although deciduous trees may also occur."
          },
          "spawn": {
            "required": {
              "terrain": "land",
              "monthsMeanTemperatureAbove10C": {
                "min": 1,
                "max": 3
              },
              "annualPrecipitationMm": {
